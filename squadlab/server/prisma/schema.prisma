generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lab {
  id          String    @id @default(uuid())
  nom         String    @unique // 'LAB1' or 'LAB3'
  description String?

  users       User[]
  components  Component[]
  projects    Project[]
}

model User {
  id               String    @id @default(uuid())
  nom              String
  prenom           String
  email            String    @unique
  passwordHash     String
  role             String    // 'LAB_ADMIN', 'SUPERVISOR', 'STUDENT'
  labId            String
  lab              Lab       @relation(fields: [labId], references: [id])
  annee            String?   // For students only
  specialite       String?   // For students only
  isApproved       Boolean   @default(false)
  dateApprobation  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  supervisedProjects   Project[]       @relation("ProjectSupervisor")
  approvedDischarges   DischargeSheet[] @relation("DischargeApprover")
  validatedDischarges  DischargeSheet[] @relation("DischargeValidator")
  stockMovements       StockMovement[]
}

model Component {
  id              String    @id @default(uuid())
  numero          Int
  codeFournisseur String?
  prix            Decimal?  
  nom             String
  labId           String
  lab             Lab       @relation(fields: [labId], references: [id])
  armoire         String?
  casier          Int?
  banque          Int?    // Compartment/slot number inside the casier
  type            String?

  // Stock quantities — CRITICAL: maintain these carefully
  qtyStock        Int       @default(0)  // Physically in storage
  qtyReservee     Int       @default(0)  // Reserved by EN_ATTENTE projects
  qtyDisponible   Int       @default(0)  // Computed: qtyStock - qtyReservee
  qtyProjets      Int       @default(0)  // Currently in active projects
  qtyEndommage    Int       @default(0)  // Damaged
  qtyPerdu        Int       @default(0)  // Lost

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dischargeItems  DischargeItem[]
  stockMovements  StockMovement[]

  // Unique component number per lab
  @@unique([numero, labId])
}

model Project {
  id            String        @id @default(uuid())
  titre         String
  type          String        // 'PFE', 'MINI_PROJET'
  statut        String        @default("EN_ATTENTE")
  labId         String
  lab           Lab           @relation(fields: [labId], references: [id])
  encadrantId   String
  encadrant     User          @relation("ProjectSupervisor", fields: [encadrantId], references: [id])
  // Chef and members stored as free text (admin types names by hand)
  chefGroupeNom String        // "Prenom Nom" free text
  membresNoms   String        @default("[]") // JSON array of name strings
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  dischargeSheets DischargeSheet[]
  stockMovements  StockMovement[]
}


model DischargeSheet {
  id               String          @id @default(uuid())
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id])
  numeroFiche      String          @unique
  statut           String          @default("EN_ATTENTE") // 'EN_ATTENTE', 'APPROUVE'
  dateCreation     DateTime        @default(now())
  dateApprobation  DateTime?
  approuvePar      String?
  approuveParUser  User?           @relation("DischargeApprover", fields: [approuvePar], references: [id])
  validePar        String?
  valideParUser    User?           @relation("DischargeValidator", fields: [validePar], references: [id])
  isRefresh        Boolean         @default(false)

  items            DischargeItem[]
}

model DischargeItem {
  id                String        @id @default(uuid())
  dischargeSheetId  String
  dischargeSheet    DischargeSheet @relation(fields: [dischargeSheetId], references: [id], onDelete: Cascade)
  componentId       String
  component         Component     @relation(fields: [componentId], references: [id], onDelete: Cascade)
  quantiteDemandee  Int
  quantiteAccordee  Int
  statutRetour      String        @default("DANS_PROJET") // 'DANS_PROJET', 'RENDU', 'ENDOMMAGE', 'PERDU'
}

model StockMovement {
  id                String        @id @default(uuid())
  componentId       String
  component         Component     @relation(fields: [componentId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?      @relation(fields: [projectId], references: [id])
  dischargeSheetId  String?
  typeMouvement     String       // 'ENTREE', 'SORTIE', 'RETOUR', 'ENDOMMAGE', 'PERDU'
  quantite          Int
  dateMouvement     DateTime     @default(now())
  effectuePar       String
  user              User         @relation(fields: [effectuePar], references: [id])
  notes             String?
}
